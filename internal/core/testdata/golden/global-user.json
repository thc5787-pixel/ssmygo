{
  "servers": [
    {
      "name": "local",
      "protocol": "mixed+udp",
      "tcpListeners": [
        {
          "network": "tcp",
          "address": "127.0.0.1:1080"
        }
      ]
    },
    {
      "name": "local-udp",
      "protocol": "socks5",
      "udpListeners": [
        {
          "network": "udp",
          "address": "127.0.0.1:1080"
        }
      ],
      "mtu": 1500
    }
  ],
  "clients": [
    {
      "name": "direct",
      "protocol": "direct",
      "enableTCP": true,
      "enableUDP": true,
      "mtu": 1500
    },
    {
      "name": "proxy",
      "protocol": "chacha20-ietf-poly1305",
      "endpoint": "ss.example.com:8388",
      "enableTCP": true,
      "enableUDP": true,
      "mtu": 1500,
      "password": "pw"
    }
  ],
  "router": {
    "defaultTCPClientName": "proxy",
    "defaultUDPClientName": "proxy"
  }
}
